---
import Landing from "../layouts/Landing.astro";
import { copy } from "../data/landing";
const c = copy.en;
const releases = [
  "0.0.12",
  "0.0.13",
  "0.0.14",
  "0.0.15",
  "0.0.16",
  "0.0.17",
  "0.0.18",
  "0.0.19",
];
---

<Landing lang="en" title={c.title} description={c.description}>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="Guso home">
      Guso<span>.</span>
    </a>
    <nav aria-label="Main navigation">
      {c.nav.map((n, i) => (
        <a
          href={`#${["product", "prescription", "architecture", "decisions", "docs"][i]}`}
        >
          {n}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="language" href={c.localeHref}>
        {c.locale}
      </a>
      <a class="button button-small" href="mailto:fjbatresv@gmail.com">
        {c.hire}
      </a>
    </div>
  </header>
  <main>
    <section class="hero section-wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">{c.kicker}</p>
        <h1 id="hero-title">{c.h1}</h1>
        <p class="hero-lede">{c.hero}</p>
        <a class="button" href="mailto:fjbatresv@gmail.com">
          {c.cta}
        </a>
        <p class="hero-role">{c.role}</p>
      </div>
      <div class="hero-art">
        <div class="phone">
          <div class="phone-top">
            <span>9:41</span>
            <span>•••</span>
          </div>
          <img
            src="/assets/intro-calendar.svg"
            width="276"
            height="186"
            alt="Illustration of a patient checking an appointment calendar"
            fetchpriority="high"
          />
          <p class="phone-label">Your next visit</p>
          <div class="appointment">
            <span class="appointment-date">
              TUE
              <br />
              <b>18</b>
            </span>
            <span>
              <b>Follow-up visit</b>
              <small>10:30 AM · Central clinic</small>
            </span>
          </div>
          <div class="phone-tabs">
            <span class="material-symbol" aria-hidden="true">
              home
            </span>
            <span class="material-symbol" aria-hidden="true">
              event
            </span>
            <span class="material-symbol" aria-hidden="true">
              favorite
            </span>
            <span class="material-symbol" aria-hidden="true">
              person
            </span>
          </div>
        </div>
      </div>
    </section>
    <section id="product" class="section-wrap product-section">
      <div class="section-heading">
        <h2>{c.productTitle}</h2>
        <p>{c.productIntro}</p>
      </div>
      <div class="product-list">
        {c.products.map(([title, body], i) => (
          <article class={`product-item product-${i + 1}`}>
            <span class="material-symbol" aria-hidden="true">
              {
                [
                  "calendar_month",
                  "prescriptions",
                  "medical_information",
                  "health_and_safety",
                  "search",
                  "notifications_active",
                ][i]
              }
            </span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>
    <section id="prescription" class="section-wrap timeline-section">
      <div class="section-heading">
        <h2>{c.timelineTitle}</h2>
        <p>{c.timelineIntro}</p>
      </div>
      <div class="timeline">
        {c.steps.map(([title, patient, system], i) => (
          <details class="timeline-step" name="prescription">
            <summary>
              <span class="step-number">0{i + 1}</span>
              <span class="step-title">{title}</span>
              <span class="step-icon material-symbol" aria-hidden="true">
                {
                  [
                    "prescriptions",
                    "schedule",
                    "notifications_active",
                    "smartphone",
                    "check_circle",
                    "schedule",
                  ][i]
                }
              </span>
            </summary>
            <div class="step-content">
              <div>
                <h3>What the patient sees</h3>
                <p>{patient}</p>
              </div>
              <div>
                <h3>What the system does</h3>
                <p>{system}</p>
              </div>
              {i === 3 && (
                <div class="reminder-preview">
                  <span class="material-symbol" aria-hidden="true">
                    notifications_active
                  </span>
                  <div>
                    <b>Medication reminder</b>
                    <p>It’s time for your 8:00 AM dose.</p>
                  </div>
                  <span class="confirmed">Today · 8:00</span>
                </div>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>
    <section id="architecture" class="section-wrap architecture-section">
      <div class="section-heading">
        <h2>{c.architectureTitle}</h2>
        <p>{c.architectureIntro}</p>
      </div>
      <div class="diagram-wrap">
        <svg
          class="architecture-diagram"
          viewBox="0 0 960 340"
          role="img"
          aria-labelledby="diagram-title diagram-desc"
        >
          <title id="diagram-title">Guso system architecture</title>
          <desc id="diagram-desc">
            A Flutter mobile application connects to a legacy API and a NestJS
            API. NestJS connects to MySQL, Firebase services, scheduled jobs,
            email and Socket.IO notifications.
          </desc>
          <defs>
            <marker
              id="arrow"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="6"
              markerHeight="6"
              orient="auto-start-reverse"
            >
              <path d="M0 0L10 5L0 10z" fill="#8e22bf" />
            </marker>
          </defs><g class="diagram-lines">
            <path d="M184 145L274 84" />
            <path d="M184 184L274 228" />
            <path d="M440 236H518" />
            <path d="M440 214Q600 112 760 82" />
            <path d="M440 236H760" />
            <path d="M440 254Q600 302 760 280" />
          </g>
          <g class="diagram-node">
            <rect x="24" y="120" width="160" height="92" rx="20" />
            <text x="104" y="158">
              Flutter app
            </text>
            <text class="sub" x="104" y="184">
              Patient experience
            </text>
            <rect x="274" y="36" width="166" height="80" rx="18" />
            <text x="357" y="72">
              Legacy API
            </text>
            <text class="sub" x="357" y="96">
              Care workflows
            </text>
            <rect x="274" y="190" width="166" height="92" rx="18" />
            <text x="357" y="228">
              NestJS API
            </text>
            <text class="sub" x="357" y="254">
              Feature modules
            </text>
            <rect x="518" y="190" width="174" height="92" rx="18" />
            <text x="605" y="228">
              MySQL
            </text>
            <text class="sub" x="605" y="254">
              TypeORM data layer
            </text>
            <rect x="760" y="30" width="176" height="80" rx="18" />
            <text x="848" y="66">
              Firebase
            </text>
            <text class="sub" x="848" y="90">
              Auth · FCM · signals
            </text>
            <rect x="760" y="135" width="176" height="80" rx="18" />
            <text x="848" y="171">
              Scheduled jobs
            </text>
            <text class="sub" x="848" y="195">
              Alerts · reminders
            </text>
            <rect x="760" y="240" width="176" height="80" rx="18" />
            <text x="848" y="276">
              Live updates
            </text>
            <text class="sub" x="848" y="300">
              Socket.IO · SMTP
            </text>
          </g>
        </svg>
      </div>
      <ul class="architecture-alt">
        <li>Flutter patient app → legacy care API and NestJS API</li>
        <li>NestJS → shared TypeORM data layer → MySQL</li>
        <li>Firebase supports sign-in, push delivery and app observability</li>
        <li>
          Scheduled jobs coordinate reminders; Socket.IO and SMTP support
          delivery
        </li>
      </ul>
    </section>
    <section id="decisions" class="section-wrap decisions-section">
      <div class="section-heading">
        <h2>{c.decisionsTitle}</h2>
      </div>
      <div class="decision-list">
        {c.decisions.map(([title, body], i) => (
          <article class="decision">
            <div>
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="section-wrap delivery-section">
      <div class="section-heading">
        <h2>{c.deliveryTitle}</h2>
        <p>{c.deliveryIntro}</p>
      </div>
      <ol class="release-line">
        {releases.map((version, i) => (
          <li>
            <span class="release-dot"></span>
            <span>{version}</span>
            {i === 0 && <small>Feb 2021</small>}
            {i === 7 && <small>Apr 2021</small>}
          </li>
        ))}
      </ol>
    </section>
    <section class="section-wrap role-section">
      <div>
        <h2>{c.roleTitle}</h2>
        <p>{c.roleText}</p>
      </div>
      <ul>
        {c.services.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    </section>
    <section id="docs" class="docs-callout">
      <div>
        <h2>How the system fits together</h2>
        <p>
          Explore the product flows, mobile architecture, backend services and
          engineering decisions.
        </p>
      </div>
      <a class="text-link" href="/docs/">
        {c.docs}
      </a>
    </section>
    <section class="contact-section">
      <div class="contact-inner">
        <h2>{c.contactTitle}</h2>
        <p>{c.contactText}</p>
        <a class="button button-light" href="mailto:fjbatresv@gmail.com">
          {c.contact}
        </a>
        <div class="social-links">
          <a href="https://fjbatresv.com">fjbatresv.com</a>
          <a href="https://www.linkedin.com/in/javierbatres/">LinkedIn</a>
          <a href="https://github.com/fjbatresv">GitHub</a>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <a class="wordmark" href="/">
      Guso<span>.</span>
    </a>
    <p>{c.footer}</p>
    <div>
      <a href="/docs/">Docs</a>
      <a href="/es/">Español</a>
    </div>
  </footer>
</Landing>
