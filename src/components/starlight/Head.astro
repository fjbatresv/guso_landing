---
import { Font } from "astro:assets";
const route = Astro.locals.starlightRoute,
  is404 = route.entry.id === "404";
const head = route.head.filter(
  ({ tag, attrs }) =>
    !(is404 && tag === "link" && attrs?.rel === "canonical") &&
    !(tag === "meta" && attrs?.name === "twitter:card"),
);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/"),
  site = Astro.site!;
const abs = (path: string) =>
  new URL(`${base}${path.replace(/^\//, "")}`, site).href;
const image = abs("assets/og-guso.png"),
  url = new URL(Astro.url.pathname, site).href,
  title = route.entry.data.title;
const schema = is404
  ? null
  : {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "TechArticle",
          headline: title,
          description: route.entry.data.description,
          url,
          inLanguage: "en",
          image,
          author: {
            "@type": "Person",
            name: "Javier Batres",
            url: "https://fjbatresv.com",
          },
          isPartOf: {
            "@type": "WebSite",
            name: "Guso technical notes",
            url: abs("/"),
          },
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "Home", item: abs("/") },
            {
              "@type": "ListItem",
              position: 2,
              name: "Docs",
              item: abs("docs/"),
            },
            ...(route.entry.id === "docs"
              ? []
              : [{ "@type": "ListItem", position: 3, name: title, item: url }]),
          ],
        },
      ],
    };
---

{head.map(({ tag: Tag, attrs, content }) => (
  <Tag {...attrs} set:html={content} />
))}
<Font cssVariable="--font-body" />
<Font cssVariable="--font-display" />
{is404 && <meta name="robots" content="noindex" />}
{!is404 && (
  <>
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Guso technical notes for a patient healthcare app"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </>
)}
